managed implementation in class zbp_r_spac112_stock unique;
strict ( 2 );

define behavior for ZR_SPAC112_STOCK alias Stock
persistent table zspac112_stock
lock master
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;

  field ( readonly : update ) warehouse_id, product_id;

  mapping for zspac112_stock corresponding;
}